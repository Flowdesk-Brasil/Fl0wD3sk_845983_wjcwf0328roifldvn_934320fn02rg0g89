# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.*

# vercel
.vercel

# launcher binaries (published via GitHub Releases)
/public/downloads/*.exe
/public/downloads/*.blockmap
/public/downloads/launcher/*.exe
/public/downloads/launcher/*.blockmap

# typescript
*.tsbuildinfo
next-env.d.ts
