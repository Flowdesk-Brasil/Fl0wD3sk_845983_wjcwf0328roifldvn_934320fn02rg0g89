NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública usada nos links de assinatura, portal e webhook.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# SMTP server-only. Pode reutilizar as credenciais do Flowdesk.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURE=true
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=Corpo & Evolução
AUTH_SMTP_ENVELOPE_FROM=
AUTH_SMTP_REPLY_TO=

# Mercado Pago server-only.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PIX_ACCESS_TOKEN=
MERCADO_PAGO_ENVIRONMENT=production
MERCADO_PAGO_PIX_ENVIRONMENT=production
MERCADO_PAGO_WEBHOOK_TOKEN=
MERCADO_PAGO_WEBHOOK_SIGNATURE_SECRET=
